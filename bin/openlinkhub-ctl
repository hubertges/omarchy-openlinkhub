#!/usr/bin/env python3
"""
openlinkhub-ctl: Command-line control utility for OpenLinkHub & Omarchy widget.
Provides quick queries and controls for liquid cooling, PSU power, fans, and RGB lighting.
"""

import sys
import os
import json
import argparse
import urllib.request
import urllib.error

DEFAULT_API_URL = os.environ.get("OPENLINKHUB_API_URL", "http://localhost:27003")
CONFIG_PATH = os.path.expanduser("~/.config/omarchy/shell.json")

def api_get(endpoint, base_url=DEFAULT_API_URL):
    url = f"{base_url.rstrip('/')}{endpoint}"
    req = urllib.request.Request(url, headers={"User-Agent": "openlinkhub-ctl"})
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"Error connecting to OpenLinkHub at {url}: {e}", file=sys.stderr)
        sys.exit(1)

def api_post(endpoint, payload, base_url=DEFAULT_API_URL):
    url = f"{base_url.rstrip('/')}{endpoint}"
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(url, data=data, headers={"Content-Type": "application/json", "User-Agent": "openlinkhub-ctl"})
    try:
        with urllib.request.urlopen(req, timeout=3) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        print(f"Error sending request to {url}: {e}", file=sys.stderr)
        sys.exit(1)

def parse_hardware(data):
    res = {
        "liquid_temp": None,
        "liquid_name": "",
        "pump_rpm": None,
        "psu_watts": None,
        "psu_name": "",
        "psu_temp": None,
        "psu_vrm_temp": None,
        "psu_rails": {},
        "cpu_temp": None,
        "gpu_temp": None,
        "ram_temp": None,
        "max_fan_rpm": None,
        "fans": [],
        "probes": [],
        "active_fan_profile": "Quiet",
        "active_rgb_mode": "wave",
        "is_cluster": False,
        "rgb_off": False,
        "brightness": 100,
        "fan_devices": [],
        "rgb_devices": []
    }
    
    devices = data.get("devices", {})
    max_fan = 0
    
    for dev_id, dev in devices.items():
        dev_name = dev.get("Product", dev_id)
        get_dev = dev.get("GetDevice")
        if not get_dev:
            continue
            
        dev_profile = get_dev.get("DeviceProfile", {})
        if dev_profile:
            if dev_profile.get("MultiProfile"):
                res["active_fan_profile"] = dev_profile["MultiProfile"]
            elif dev_profile.get("SpeedProfiles"):
                for sp in dev_profile["SpeedProfiles"].values():
                    if sp:
                        res["active_fan_profile"] = sp
                        break
            if dev_profile.get("MultiRGB"):
                res["active_rgb_mode"] = dev_profile["MultiRGB"]
            if dev_profile.get("RGBCluster") is not None:
                res["is_cluster"] = dev_profile.get("RGBCluster")
            if dev_profile.get("RgbOff") is not None:
                res["rgb_off"] = dev_profile.get("RgbOff")
            if dev_profile.get("BrightnessSlider") is not None:
                res["brightness"] = dev_profile.get("BrightnessSlider")
                
        if get_dev.get("CpuTemp") and (res["cpu_temp"] is None or get_dev["CpuTemp"] > 0):
            res["cpu_temp"] = get_dev["CpuTemp"]
        if get_dev.get("GpuTemp") and (res["gpu_temp"] is None or get_dev["GpuTemp"] > 0):
            res["gpu_temp"] = get_dev["GpuTemp"]
            
        channels = get_dev.get("devices", {})
        has_fans = False
        has_rgb = bool(get_dev.get("RGBModes"))
        is_psu = bool(get_dev.get("IsPSU")) or "RM" in dev_name or "PSU" in dev_name
        
        for ch_id, ch in channels.items():
            ch_name = ch.get("name", f"Channel {ch_id}")
            desc = ch.get("description", "")
            rpm = ch.get("rpm")
            temp = ch.get("temperature")
            watts = ch.get("watts")
            profile = ch.get("profile")
            
            # AIO Liquid Cooler
            if desc == "AIO" or "LCD" in ch_name or "H150" in ch_name or "Cooler" in ch_name:
                if temp is not None and temp > 0:
                    res["liquid_temp"] = round(temp, 1)
                    res["liquid_name"] = ch_name
                if rpm is not None and rpm > 0:
                    res["pump_rpm"] = rpm
                    
            # PSU
            if is_psu or desc == "Output Power" or ch_name == "Power Out":
                if watts is not None and (res["psu_watts"] is None or watts > res["psu_watts"]):
                    res["psu_watts"] = round(watts)
                    res["psu_name"] = dev_name
                if "VRM" in ch_name and temp is not None and temp > 0:
                    res["psu_vrm_temp"] = round(temp, 1)
                elif "PSU" in ch_name and temp is not None and temp > 0:
                    res["psu_temp"] = round(temp, 1)
                if "Rail" in ch_name:
                    res["psu_rails"][ch_name] = {
                        "watts": round(watts, 1) if watts is not None else 0,
                        "volts": ch.get("volts", 0),
                        "amps": ch.get("amps", 0)
                    }
                    
            # RAM
            if "DOMINATOR" in ch_name or "Memory" in dev_name:
                if temp is not None and temp > 0 and (res["ram_temp"] is None or temp > res["ram_temp"]):
                    res["ram_temp"] = round(temp, 1)
                    
            # Fans (Exclude PSU)
            if (desc == "Fan" or "Fan" in ch_name) and not is_psu:
                has_fans = True
                if rpm is not None:
                    if rpm > max_fan:
                        max_fan = rpm
                    res["fans"].append({
                        "dev_id": dev_id,
                        "dev_name": dev_name,
                        "channel_id": ch_id,
                        "name": ch_name,
                        "rpm": rpm,
                        "temp": temp,
                        "profile": profile
                    })
                    
            # Probes
            if desc == "Probe" or "Probe" in ch_name or ("Temperature" in ch_name and desc != "AIO"):
                if temp is not None and temp > 0:
                    res["probes"].append({
                        "dev_id": dev_id,
                        "dev_name": dev_name,
                        "channel_id": ch_id,
                        "name": ch_name,
                        "temp": round(temp, 1)
                    })
                    
        if has_fans and not is_psu:
            res["fan_devices"].append(dev_id)
        if has_rgb:
            res["rgb_devices"].append(dev_id)
            
    if max_fan > 0:
        res["max_fan_rpm"] = max_fan
        
    return res

def cmd_status(args):
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    if args.json:
        print(json.dumps(hw, indent=2))
        return
        
    print("========================================")
    print("       OpenLinkHub Hardware Status      ")
    print("========================================")
    
    if hw["liquid_temp"] is not None:
        print(f"💧 Coolant Temp:  {hw['liquid_temp']} °C ({hw['liquid_name']})")
    if hw["pump_rpm"] is not None:
        print(f"󰈐 Pump Speed:    {hw['pump_rpm']} RPM")
        
    if hw["psu_watts"] is not None:
        print(f"󱐋 PSU Power:     {hw['psu_watts']} W ({hw['psu_name']})")
        for rail, details in hw["psu_rails"].items():
            print(f"   • {rail}: {details['watts']}W ({details['volts']}V / {details['amps']}A)")
        if hw["psu_vrm_temp"] is not None:
            print(f"   • VRM Temp: {hw['psu_vrm_temp']} °C")
            
    print("----------------------------------------")
    if hw["cpu_temp"] is not None:
        print(f"󰍛 CPU Package:   {hw['cpu_temp']} °C")
    if hw["gpu_temp"] is not None:
        print(f"󰢮 GPU Core:      {hw['gpu_temp']} °C")
    if hw["ram_temp"] is not None:
        print(f"󰘚 RAM Temp:      {hw['ram_temp']} °C")
        
    print("----------------------------------------")
    if hw["fans"]:
        print(f"󰠝 Fans ({len(hw['fans'])} connected, Max: {hw['max_fan_rpm']} RPM, Profile: {hw['active_fan_profile']}):")
        for f in hw["fans"]:
            print(f"   • {f['name']} ({f['dev_name']}): {f['rpm']} RPM")
            
    print("----------------------------------------")
    print(f"󰏌 Active RGB:    {hw['active_rgb_mode'].upper()} (Brightness: {hw['brightness']}%)")
    print("========================================")

def cmd_query(args):
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    m = args.metric.lower().replace("-", "_")
    
    mapping = {
        "liquid_temp": f"{hw['liquid_temp']} °C" if hw['liquid_temp'] is not None else "--",
        "pump_rpm": f"{hw['pump_rpm']} RPM" if hw['pump_rpm'] is not None else "--",
        "psu_power": f"{hw['psu_watts']} W" if hw['psu_watts'] is not None else "--",
        "cpu_temp": f"{hw['cpu_temp']} °C" if hw['cpu_temp'] is not None else "--",
        "gpu_temp": f"{hw['gpu_temp']} °C" if hw['gpu_temp'] is not None else "--",
        "ram_temp": f"{hw['ram_temp']} °C" if hw['ram_temp'] is not None else "--",
        "fan_rpm": f"{hw['max_fan_rpm']} RPM" if hw['max_fan_rpm'] is not None else "--",
        "psu_vrm_temp": f"{hw['psu_vrm_temp']} °C" if hw['psu_vrm_temp'] is not None else "--",
        "active_fan": hw['active_fan_profile'],
        "active_rgb": hw['active_rgb_mode']
    }
    
    if m in mapping:
        print(mapping[m])
    else:
        print(f"Unknown metric: {args.metric}", file=sys.stderr)
        sys.exit(1)

def cmd_fan(args):
    # Fetch available profiles from /api/temperatures
    avail_profiles = ["Quiet", "Normal", "Performance"]
    try:
        t_data = api_get("/api/temperatures", args.api_url)
        if t_data and isinstance(t_data.get("data"), dict):
            avail_profiles = [k for k, v in t_data["data"].items() if not v.get("Hidden")]
    except Exception:
        pass

    profile = args.profile
    for p in avail_profiles:
        if p.lower() == args.profile.lower():
            profile = p
            break

    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    targets = hw["fan_devices"] if hw["fan_devices"] else ["62605BBB76606751B331EACF1C495170", "1005010593341009"]
    
    success = False
    for dev_id in targets:
        res = api_post("/api/speed", {"deviceId": dev_id, "channelId": -1, "profile": profile}, args.api_url)
        if res.get("status") == 1 or res.get("code") == 200:
            success = True
            
    if success:
        print(f"Successfully applied fan speed profile '{profile}' across all devices ({len(targets)} controllers).")
    else:
        print(f"Warning: could not confirm fan profile change for '{profile}'.", file=sys.stderr)

def cmd_rgb(args):
    mode = args.mode.lower()
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    # Send to cluster
    api_post("/api/color", {"deviceId": "cluster", "channelId": 0, "profile": mode}, args.api_url)
    
    # Send to RGB devices
    targets = hw["rgb_devices"] if hw["rgb_devices"] else ["62605BBB76606751B331EACF1C495170", "i2c11"]
    for dev_id in targets:
        api_post("/api/color", {"deviceId": dev_id, "channelId": -1, "profile": mode}, args.api_url)
        
    print(f"Successfully set RGB lighting mode to '{mode}'.")

def cmd_brightness(args):
    try:
        val = int(args.level)
        if not (0 <= val <= 100):
            raise ValueError()
    except ValueError:
        print("Error: Brightness level must be an integer between 0 and 100.", file=sys.stderr)
        sys.exit(1)
        
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    api_post("/api/brightness/gradual", {"deviceId": "cluster", "brightness": val}, args.api_url)
    for dev_id in hw["rgb_devices"]:
        api_post("/api/brightness/gradual", {"deviceId": dev_id, "brightness": val}, args.api_url)
        
    print(f"Successfully set RGB brightness to {val}%.")

def cmd_bar_metric(args):
    metric = args.metric.lower().replace("-", "_")
    if not os.path.exists(CONFIG_PATH):
        print(f"Error: {CONFIG_PATH} not found.", file=sys.stderr)
        sys.exit(1)
        
    try:
        with open(CONFIG_PATH, "r") as f:
            cfg = json.load(f)
            
        found = False
        sections = ["right", "center", "left"]
        for s in sections:
            for item in cfg.get("bar", {}).get("layout", {}).get(s, []):
                if isinstance(item, dict) and item.get("id") == "hubi.openlinkhub":
                    item["displayMetric"] = metric
                    found = True
                    break
            if found:
                break
                
        if not found:
            print("Warning: hubi.openlinkhub was not found in shell.json, creating entry...")
            cfg.setdefault("bar", {}).setdefault("layout", {}).setdefault("right", []).append({
                "id": "hubi.openlinkhub",
                "displayMetric": metric
            })
            
        with open(CONFIG_PATH, "w") as f:
            json.dump(cfg, f, indent=2)
            f.write("\n")
            
        print(f"Successfully set default bar metric to '{metric}' in {CONFIG_PATH}.")
    except Exception as e:
        print(f"Error updating config: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="openlinkhub-ctl: OpenLinkHub Hardware Control CLI")
    parser.add_argument("--api-url", default=DEFAULT_API_URL, help="OpenLinkHub base URL")
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    # status
    p_status = subparsers.add_parser("status", help="Show all hardware monitoring stats")
    p_status.add_argument("--json", action="store_true", help="Output raw JSON")
    p_status.set_defaults(func=cmd_status)
    
    # query
    p_query = subparsers.add_parser("query", help="Query a specific metric")
    p_query.add_argument("metric", help="Metric to query (liquid_temp, psu_power, cpu_temp, gpu_temp, ram_temp, pump_rpm, fan_rpm, psu_vrm_temp, active_fan, active_rgb)")
    p_query.set_defaults(func=cmd_query)
    
    # fan
    p_fan = subparsers.add_parser("fan", help="Apply fan speed profile across all controllers")
    p_fan.add_argument("profile", help="Profile name (e.g. Quiet, Normal, Performance, or custom user profile)")
    p_fan.set_defaults(func=cmd_fan)
    
    # rgb
    p_rgb = subparsers.add_parser("rgb", help="Apply RGB lighting preset")
    p_rgb.add_argument("mode", help="RGB preset mode (e.g. wave, rainbow, static, colorpulse, storm, off)")
    p_rgb.set_defaults(func=cmd_rgb)
    
    # brightness
    p_bright = subparsers.add_parser("brightness", help="Set RGB brightness percentage")
    p_bright.add_argument("level", help="Brightness level (0-100)")
    p_bright.set_defaults(func=cmd_brightness)
    
    # bar-metric
    p_bar = subparsers.add_parser("bar-metric", help="Set default statistic shown on Omarchy bar")
    p_bar.add_argument("metric", help="Metric key or sensor key to display on the bar")
    p_bar.set_defaults(func=cmd_bar_metric)
    
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
