#!/usr/bin/env python3
"""
openlinkhub-ctl: Command-line control utility for OpenLinkHub & Omarchy widget.
Provides quick queries and controls for liquid cooling, PSU power, fans, and RGB lighting.
"""

import sys
import os
import json
import argparse
import urllib.request
import urllib.error
import urllib.parse
import fcntl
import stat
import tempfile

DEFAULT_API_URL = os.environ.get("OPENLINKHUB_API_URL", "http://localhost:27003")
CONFIG_PATH = os.path.expanduser("~/.config/omarchy/shell.json")
MAX_RESPONSE_BYTES = 5 * 1024 * 1024  # 5 MB max response body
MAX_CONFIG_SIZE = 1 * 1024 * 1024     # 1 MB max shell.json config size
REQUEST_TIMEOUT = 3                   # 3 seconds network timeout

class NoRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Prevent automatic redirects to arbitrary destinations."""
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if fp is not None:
            try:
                fp.close()
            except Exception:
                pass
        raise urllib.error.HTTPError(
            req.full_url, code, f"HTTP redirects disabled for security (blocked destination: {newurl})", headers, None
        )

_opener = urllib.request.build_opener(NoRedirectHandler)

def validate_api_url(base_url, endpoint=""):
    """Validate URL scheme and format to prevent SSRF to arbitrary schemes or destinations."""
    parsed = urllib.parse.urlparse(base_url)
    if parsed.scheme not in ("http", "https"):
        raise ValueError(f"Invalid API URL scheme: {parsed.scheme!r}. Only 'http' and 'https' are permitted.")
    if not parsed.netloc:
        raise ValueError(f"Invalid API URL: missing host in {base_url!r}")

    clean_base = f"{parsed.scheme}://{parsed.netloc}{parsed.path}".rstrip("/")
    clean_endpoint = endpoint if endpoint.startswith("/") else f"/{endpoint}"
    full_url = f"{clean_base}{clean_endpoint}"

    parsed_full = urllib.parse.urlparse(full_url)
    if parsed_full.scheme not in ("http", "https"):
        raise ValueError(f"Invalid request URL scheme: {parsed_full.scheme!r}")
    return full_url

def read_limited_response(resp, max_bytes=MAX_RESPONSE_BYTES):
    """Read response body with a strict maximum byte limit to avoid memory exhaustion."""
    body = resp.read(max_bytes + 1)
    if len(body) > max_bytes:
        raise ValueError(f"API response size exceeded maximum allowed limit ({max_bytes} bytes).")
    return body.decode("utf-8")

def update_shell_config(config_path, transform_fn, max_retries=5):
    """
    Safely reads, modifies via transform_fn(cfg), and atomically writes shell.json.
    Enforces:
      - Symlink rejection (no-follow)
      - Regular file checks
      - File size limits (MAX_CONFIG_SIZE)
      - File locking (fcntl.flock LOCK_EX with inode validation against rename races)
      - Atomic write via temporary file in same directory with private permissions (0o600)
    """
    config_dir = os.path.dirname(os.path.abspath(config_path))
    if not os.path.isdir(config_dir):
        os.makedirs(config_dir, mode=0o700, exist_ok=True)

    if not os.path.lexists(config_path):
        raise FileNotFoundError(f"Config file not found: {config_path}")

    open_flags = os.O_RDWR | getattr(os, "O_NOFOLLOW", 0) | getattr(os, "O_CLOEXEC", 0)

    for attempt in range(max_retries):
        if os.path.islink(config_path):
            raise ValueError(f"Security error: {config_path} is a symbolic link.")

        st_path = os.lstat(config_path)
        if not stat.S_ISREG(st_path.st_mode):
            raise ValueError(f"Security error: {config_path} is not a regular file.")
        if st_path.st_size > MAX_CONFIG_SIZE:
            raise ValueError(f"Security error: {config_path} exceeds maximum allowed size ({MAX_CONFIG_SIZE} bytes).")

        fd = os.open(config_path, open_flags)
        tmp_path = None
        temp_fd = None
        try:
            fcntl.flock(fd, fcntl.LOCK_EX)

            st_fd = os.fstat(fd)
            if not stat.S_ISREG(st_fd.st_mode):
                raise ValueError(f"Security error: {config_path} is not a regular file.")
            if st_fd.st_size > MAX_CONFIG_SIZE:
                raise ValueError(f"Security error: {config_path} exceeds maximum allowed size.")

            # Verify the locked descriptor still matches the file on disk (guards against rename races)
            st_cur = os.lstat(config_path)
            if st_cur.st_ino != st_fd.st_ino or st_cur.st_dev != st_fd.st_dev:
                # File was replaced while waiting for the lock; retry with the newly created file
                continue

            with os.fdopen(os.dup(fd), "r", encoding="utf-8") as f:
                content = f.read(MAX_CONFIG_SIZE + 1)
                if len(content) > MAX_CONFIG_SIZE:
                    raise ValueError(f"Security error: {config_path} exceeds maximum allowed size.")
                cfg = json.loads(content) if content.strip() else {}

            modified_cfg, should_write = transform_fn(cfg)
            if not should_write:
                return False

            temp_fd, tmp_path = tempfile.mkstemp(dir=config_dir, prefix=".shell.json.tmp.", text=True)
            os.fchmod(temp_fd, 0o600)
            with os.fdopen(temp_fd, "w", encoding="utf-8") as tf:
                temp_fd = None  # tf took ownership
                json.dump(modified_cfg, tf, indent=2)
                tf.write("\n")
                tf.flush()
                os.fsync(tf.fileno())

            os.replace(tmp_path, config_path)
            tmp_path = None
            return True
        finally:
            if temp_fd is not None:
                try:
                    os.close(temp_fd)
                except Exception:
                    pass
            try:
                fcntl.flock(fd, fcntl.LOCK_UN)
            except Exception:
                pass
            os.close(fd)
            if tmp_path and os.path.exists(tmp_path):
                try:
                    os.remove(tmp_path)
                except Exception:
                    pass
    raise RuntimeError(f"Could not safely acquire lock on {config_path} after {max_retries} attempts.")

def api_get(endpoint, base_url=DEFAULT_API_URL):
    try:
        url = validate_api_url(base_url, endpoint)
        req = urllib.request.Request(url, headers={"User-Agent": "openlinkhub-ctl"})
        with _opener.open(req, timeout=REQUEST_TIMEOUT) as resp:
            text = read_limited_response(resp)
            return json.loads(text)
    except Exception as e:
        if hasattr(e, "close"):
            try:
                e.close()
            except Exception:
                pass
        print(f"Error connecting to OpenLinkHub at {base_url}: {e}", file=sys.stderr)
        sys.exit(1)

def api_post(endpoint, payload, base_url=DEFAULT_API_URL, method="POST"):
    try:
        url = validate_api_url(base_url, endpoint)
        data = json.dumps(payload).encode("utf-8")
        req = urllib.request.Request(
            url,
            data=data,
            headers={"Content-Type": "application/json", "User-Agent": "openlinkhub-ctl"},
            method=method
        )
        with _opener.open(req, timeout=REQUEST_TIMEOUT) as resp:
            text = read_limited_response(resp)
            return json.loads(text)
    except Exception as e:
        if hasattr(e, "close"):
            try:
                e.close()
            except Exception:
                pass
        print(f"Error sending request to {base_url}: {e}", file=sys.stderr)
        sys.exit(1)

def api_put(endpoint, payload, base_url=DEFAULT_API_URL):
    return api_post(endpoint, payload, base_url=base_url, method="PUT")

def parse_hardware(data):
    res = {
        "liquid_temp": None,
        "liquid_name": "",
        "pump_rpm": None,
        "psu_watts": None,
        "psu_name": "",
        "psu_temp": None,
        "psu_vrm_temp": None,
        "psu_rails": {},
        "cpu_temp": None,
        "gpu_temp": None,
        "ram_temp": None,
        "max_fan_rpm": None,
        "fans": [],
        "probes": [],
        "active_fan_profile": "Quiet",
        "active_rgb_mode": "wave",
        "is_cluster": False,
        "rgb_off": False,
        "brightness": 100,
        "fan_devices": [],
        "rgb_devices": []
    }
    
    devices = data.get("devices", {})
    max_fan = 0
    
    for dev_id, dev in devices.items():
        dev_name = dev.get("Product", dev_id)
        get_dev = dev.get("GetDevice")
        if not get_dev:
            continue
            
        dev_profile = get_dev.get("DeviceProfile", {})
        if dev_profile:
            if dev_profile.get("MultiProfile"):
                res["active_fan_profile"] = dev_profile["MultiProfile"]
            elif dev_profile.get("SpeedProfiles"):
                for sp in dev_profile["SpeedProfiles"].values():
                    if sp:
                        res["active_fan_profile"] = sp
                        break
            if dev_profile.get("MultiRGB"):
                res["active_rgb_mode"] = dev_profile["MultiRGB"]
            if dev_profile.get("RGBCluster") is not None:
                res["is_cluster"] = dev_profile.get("RGBCluster")
            if dev_profile.get("RgbOff") is not None:
                res["rgb_off"] = dev_profile.get("RgbOff")
            if dev_profile.get("BrightnessSlider") is not None:
                res["brightness"] = dev_profile.get("BrightnessSlider")
                
        if get_dev.get("CpuTemp") and (res["cpu_temp"] is None or get_dev["CpuTemp"] > 0):
            res["cpu_temp"] = get_dev["CpuTemp"]
        if get_dev.get("GpuTemp") and (res["gpu_temp"] is None or get_dev["GpuTemp"] > 0):
            res["gpu_temp"] = get_dev["GpuTemp"]
            
        channels = get_dev.get("devices", {})
        has_fans = False
        has_rgb = bool(get_dev.get("RGBModes"))
        is_psu = bool(get_dev.get("IsPSU")) or "RM" in dev_name or "PSU" in dev_name
        
        for ch_id, ch in channels.items():
            ch_name = ch.get("name", f"Channel {ch_id}")
            desc = ch.get("description", "")
            rpm = ch.get("rpm")
            temp = ch.get("temperature")
            watts = ch.get("watts")
            profile = ch.get("profile")
            
            # AIO Liquid Cooler
            if desc == "AIO" or "LCD" in ch_name or "H150" in ch_name or "Cooler" in ch_name:
                if temp is not None and temp > 0:
                    res["liquid_temp"] = round(temp, 1)
                    res["liquid_name"] = ch_name
                if rpm is not None and rpm > 0:
                    res["pump_rpm"] = rpm
                    
            # PSU
            if is_psu or desc == "Output Power" or ch_name == "Power Out":
                if watts is not None and (res["psu_watts"] is None or watts > res["psu_watts"]):
                    res["psu_watts"] = round(watts)
                    res["psu_name"] = dev_name
                if "VRM" in ch_name and temp is not None and temp > 0:
                    res["psu_vrm_temp"] = round(temp, 1)
                elif "PSU" in ch_name and temp is not None and temp > 0:
                    res["psu_temp"] = round(temp, 1)
                if "Rail" in ch_name:
                    res["psu_rails"][ch_name] = {
                        "watts": round(watts, 1) if watts is not None else 0,
                        "volts": ch.get("volts", 0),
                        "amps": ch.get("amps", 0)
                    }
                    
            # RAM
            if "DOMINATOR" in ch_name or "Memory" in dev_name:
                if temp is not None and temp > 0 and (res["ram_temp"] is None or temp > res["ram_temp"]):
                    res["ram_temp"] = round(temp, 1)
                    
            # Fans (Exclude PSU)
            if (desc == "Fan" or "Fan" in ch_name) and not is_psu:
                has_fans = True
                if rpm is not None:
                    if rpm > max_fan:
                        max_fan = rpm
                    res["fans"].append({
                        "dev_id": dev_id,
                        "dev_name": dev_name,
                        "channel_id": ch_id,
                        "name": ch_name,
                        "rpm": rpm,
                        "temp": temp,
                        "profile": profile
                    })
                    
            # Probes
            if desc == "Probe" or "Probe" in ch_name or ("Temperature" in ch_name and desc != "AIO"):
                if temp is not None and temp > 0:
                    res["probes"].append({
                        "dev_id": dev_id,
                        "dev_name": dev_name,
                        "channel_id": ch_id,
                        "name": ch_name,
                        "temp": round(temp, 1)
                    })
                    
        if has_fans and not is_psu:
            res["fan_devices"].append(dev_id)
        if has_rgb:
            res["rgb_devices"].append(dev_id)
            
    if max_fan > 0:
        res["max_fan_rpm"] = max_fan
        
    return res

def hex_to_rgb(hex_str):
    clean = hex_str.lstrip("#").strip()
    if len(clean) == 3:
        clean = clean[0] + clean[0] + clean[1] + clean[1] + clean[2] + clean[2]
    if len(clean) >= 6:
        try:
            return {
                "red": int(clean[0:2], 16),
                "green": int(clean[2:4], 16),
                "blue": int(clean[4:6], 16),
                "temperature": 0
            }
        except ValueError:
            pass
    return {"red": 0, "green": 255, "blue": 255, "temperature": 0}

def cmd_status(args):
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    if args.json:
        print(json.dumps(hw, indent=2))
        return
        
    print("========================================")
    print("       OpenLinkHub Hardware Status      ")
    print("========================================")
    
    if hw["liquid_temp"] is not None:
        print(f"󰔏 Coolant Temp:  {hw['liquid_temp']} °C ({hw['liquid_name']})")
    if hw["pump_rpm"] is not None:
        print(f"󰈐 Pump Speed:    {hw['pump_rpm']} RPM")
        
    if hw["psu_watts"] is not None:
        print(f"󱐋 PSU Power:     {hw['psu_watts']} W ({hw['psu_name']})")
        for rail, details in hw["psu_rails"].items():
            print(f"   • {rail}: {details['watts']}W ({details['volts']}V / {details['amps']}A)")
        if hw["psu_vrm_temp"] is not None:
            print(f"   • VRM Temp: {hw['psu_vrm_temp']} °C")
            
    print("----------------------------------------")
    if hw["cpu_temp"] is not None:
        print(f"󰍛 CPU Package:   {hw['cpu_temp']} °C")
    if hw["gpu_temp"] is not None:
        print(f"󰢮 GPU Core:      {hw['gpu_temp']} °C")
    if hw["ram_temp"] is not None:
        print(f"󰘚 RAM Temp:      {hw['ram_temp']} °C")
        
    print("----------------------------------------")
    if hw["fans"]:
        print(f"󰠝 Fans ({len(hw['fans'])} connected, Max: {hw['max_fan_rpm']} RPM, Profile: {hw['active_fan_profile']}):")
        for f in hw["fans"]:
            print(f"   • {f['name']} ({f['dev_name']}): {f['rpm']} RPM")
            
    print("----------------------------------------")
    print(f"󰏌 Active RGB:    {hw['active_rgb_mode'].upper()} (Brightness: {hw['brightness']}%)")
    print("========================================")

def cmd_query(args):
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    m = args.metric.lower().replace("-", "_")
    
    mapping = {
        "liquid_temp": f"{hw['liquid_temp']} °C" if hw['liquid_temp'] is not None else "--",
        "liquid": f"{hw['liquid_temp']} °C" if hw['liquid_temp'] is not None else "--",
        "pump_rpm": f"{hw['pump_rpm']} RPM" if hw['pump_rpm'] is not None else "--",
        "pump": f"{hw['pump_rpm']} RPM" if hw['pump_rpm'] is not None else "--",
        "psu_power": f"{hw['psu_watts']} W" if hw['psu_watts'] is not None else "--",
        "psu": f"{hw['psu_watts']} W" if hw['psu_watts'] is not None else "--",
        "cpu_temp": f"{hw['cpu_temp']} °C" if hw['cpu_temp'] is not None else "--",
        "cpu": f"{hw['cpu_temp']} °C" if hw['cpu_temp'] is not None else "--",
        "gpu_temp": f"{hw['gpu_temp']} °C" if hw['gpu_temp'] is not None else "--",
        "gpu": f"{hw['gpu_temp']} °C" if hw['gpu_temp'] is not None else "--",
        "ram_temp": f"{hw['ram_temp']} °C" if hw['ram_temp'] is not None else "--",
        "ram": f"{hw['ram_temp']} °C" if hw['ram_temp'] is not None else "--",
        "fan_rpm": f"{hw['max_fan_rpm']} RPM" if hw['max_fan_rpm'] is not None else "--",
        "fan": f"{hw['max_fan_rpm']} RPM" if hw['max_fan_rpm'] is not None else "--",
        "psu_vrm_temp": f"{hw['psu_vrm_temp']} °C" if hw['psu_vrm_temp'] is not None else "--",
        "vrm": f"{hw['psu_vrm_temp']} °C" if hw['psu_vrm_temp'] is not None else "--",
        "active_fan": hw['active_fan_profile'],
        "fan_profile": hw['active_fan_profile'],
        "active_rgb": hw['active_rgb_mode'],
        "rgb_mode": hw['active_rgb_mode']
    }
    
    if m in mapping:
        print(mapping[m])
    else:
        print(f"Unknown metric: {args.metric}", file=sys.stderr)
        sys.exit(1)

def cmd_fan(args):
    avail_profiles = ["Quiet", "Normal", "Performance"]
    try:
        t_data = api_get("/api/temperatures", args.api_url)
        if t_data and isinstance(t_data.get("data"), dict):
            avail_profiles = [k for k, v in t_data["data"].items() if isinstance(v, dict) and not v.get("Hidden")]
    except Exception:
        pass

    profile = args.profile
    for p in avail_profiles:
        if p.lower() == args.profile.lower():
            profile = p
            break

    devs_data = api_get("/api/devices/", args.api_url)
    devs = devs_data.get("devices", {})
    count = 0
    
    for dev_id, dev in devs.items():
        get_dev = dev.get("GetDevice") or {}
        dev_name = dev.get("Product", dev_id)
        if get_dev.get("IsPSU") or "RM" in dev_name or "PSU" in dev_name or "Memory" in dev_name or dev_id == "cluster":
            continue
            
        channels = get_dev.get("devices") or {}
        fan_channels = [ch_id for ch_id, ch in channels.items() if ch.get("description") == "Fan" or "Fan" in ch.get("name", "") or ch.get("rpm") is not None]
        
        if fan_channels or get_dev.get("DeviceProfile", {}).get("MultiProfile") is not None:
            count += 1
            # 1. Global device broadcast
            api_post("/api/speed", {"deviceId": dev_id, "channelId": -1, "profile": profile}, args.api_url)
            # 2. Per-channel broadcast for controllers like Commander Pro
            for ch_id in fan_channels:
                try:
                    api_post("/api/speed", {"deviceId": dev_id, "channelId": int(ch_id), "profile": profile}, args.api_url)
                except Exception:
                    pass
                    
    print(f"Successfully applied fan speed profile '{profile}' across all devices ({count} controllers).")

def cmd_rgb(args):
    mode = args.mode.lower()
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    # Send to cluster
    api_post("/api/color", {"deviceId": "cluster", "channelId": 0, "profile": mode}, args.api_url)
    
    # Send to RGB devices
    targets = hw["rgb_devices"] if hw["rgb_devices"] else ["62605BBB76606751B331EACF1C495170", "i2c11"]
    for dev_id in targets:
        api_post("/api/color", {"deviceId": dev_id, "channelId": -1, "profile": mode}, args.api_url)
        
    print(f"Successfully set RGB lighting mode to '{mode}'.")

def cmd_colors(args):
    mode = args.mode.lower()
    p1 = hex_to_rgb(args.primary)
    p2 = hex_to_rgb(args.secondary if args.secondary else args.primary)
    
    targets = ["cluster", "62605BBB76606751B331EACF1C495170", "1005010593341009", "1D700317A81C7CAF9619A75F051C00F5", "i2c11"]
    for t in targets:
        payload = {
            "deviceId": t,
            "profile": mode,
            "startColor": p1,
            "endColor": p2,
            "middleColor": {"red": 0, "green": 0, "blue": 0, "temperature": 0},
            "speed": 2,
            "alternateColors": False,
            "rgbDirection": 0
        }
        api_post("/api/color/change", payload, args.api_url, method="PUT")
        
    api_post("/api/color/global", {"profile": mode}, args.api_url)
    api_post("/api/color", {"deviceId": "cluster", "channelId": 0, "profile": mode}, args.api_url)
    for t in targets[1:]:
        api_post("/api/color", {"deviceId": t, "channelId": -1, "profile": mode}, args.api_url)
    print(f"Successfully set RGB colors for '{mode}' to {args.primary} / {args.secondary or args.primary} with immediate reload.")

def cmd_brightness(args):
    try:
        val = int(args.level)
        if not (0 <= val <= 100):
            raise ValueError()
    except ValueError:
        print("Error: Brightness level must be an integer between 0 and 100.", file=sys.stderr)
        sys.exit(1)
        
    data = api_get("/api/devices/", args.api_url)
    hw = parse_hardware(data)
    
    api_post("/api/brightness/gradual", {"deviceId": "cluster", "brightness": val}, args.api_url)
    for dev_id in hw["rgb_devices"]:
        api_post("/api/brightness/gradual", {"deviceId": dev_id, "brightness": val}, args.api_url)
        
    print(f"Successfully set RGB brightness to {val}%.")

def cmd_bar_metric(args):
    metric = args.metric.lower().replace("-", "_")
    if not os.path.lexists(CONFIG_PATH):
        print(f"Error: {CONFIG_PATH} not found.", file=sys.stderr)
        sys.exit(1)

    def _transform(cfg):
        if not isinstance(cfg, dict):
            cfg = {}
        bar = cfg.get("bar")
        if not isinstance(bar, dict):
            bar = {}
            cfg["bar"] = bar
        layout = bar.get("layout")
        if not isinstance(layout, dict):
            layout = {"left": [], "center": [], "right": []}
            bar["layout"] = layout

        found = False
        sections = ["right", "center", "left"]
        for s in sections:
            sec_items = layout.get(s)
            if isinstance(sec_items, list):
                for item in sec_items:
                    if isinstance(item, dict) and item.get("id") in ("hubi.openlinkhub", "omarchy.openlinkhub"):
                        item["displayMetric"] = metric
                        found = True
                        break
            if found:
                break

        if not found:
            right_sec = layout.get("right")
            if not isinstance(right_sec, list):
                right_sec = []
                layout["right"] = right_sec
            print("Warning: hubi.openlinkhub was not found in shell.json, creating entry...")
            right_sec.append({
                "id": "hubi.openlinkhub",
                "displayMetric": metric
            })
        return cfg, True

    try:
        update_shell_config(CONFIG_PATH, _transform)
        print(f"Successfully set default bar metric to '{metric}' in {CONFIG_PATH}.")
    except Exception as e:
        print(f"Error updating config: {e}", file=sys.stderr)
        sys.exit(1)

def main():
    parser = argparse.ArgumentParser(description="openlinkhub-ctl: OpenLinkHub Hardware Control CLI")
    parser.add_argument("--api-url", default=DEFAULT_API_URL, help="OpenLinkHub base URL")
    subparsers = parser.add_subparsers(dest="command", required=True)
    
    # status
    p_status = subparsers.add_parser("status", help="Show all hardware monitoring stats")
    p_status.add_argument("--json", action="store_true", help="Output raw JSON")
    p_status.set_defaults(func=cmd_status)
    
    # query (with 'get' alias)
    p_query = subparsers.add_parser("query", aliases=["get"], help="Query a specific metric")
    p_query.add_argument("metric", help="Metric to query (liquid_temp, psu_power, cpu_temp, gpu_temp, ram_temp, pump_rpm, fan_rpm, psu_vrm_temp, active_fan, active_rgb)")
    p_query.set_defaults(func=cmd_query)
    
    # fan
    p_fan = subparsers.add_parser("fan", help="Apply fan speed profile across all controllers")
    p_fan.add_argument("profile", help="Profile name (e.g. Quiet, Normal, Performance, or custom user profile)")
    p_fan.set_defaults(func=cmd_fan)
    
    # rgb
    p_rgb = subparsers.add_parser("rgb", help="Apply RGB lighting preset")
    p_rgb.add_argument("mode", help="RGB preset mode (e.g. wave, rainbow, static, colorpulse, storm, off)")
    p_rgb.set_defaults(func=cmd_rgb)

    # colors
    p_colors = subparsers.add_parser("colors", help="Set RGB primary and secondary colors")
    p_colors.add_argument("mode", help="RGB mode (e.g. static, wave, colorpulse, colorshift)")
    p_colors.add_argument("primary", help="Primary color in hex (e.g. '#06b6d4')")
    p_colors.add_argument("secondary", nargs="?", default=None, help="Secondary color in hex (e.g. '#3b82f6')")
    p_colors.set_defaults(func=cmd_colors)
    
    # brightness
    p_bright = subparsers.add_parser("brightness", help="Set RGB brightness percentage")
    p_bright.add_argument("level", help="Brightness level (0-100)")
    p_bright.set_defaults(func=cmd_brightness)
    
    # bar-metric (with 'metric' alias)
    p_bar = subparsers.add_parser("bar-metric", aliases=["metric"], help="Set default statistic shown on Omarchy bar")
    p_bar.add_argument("metric", help="Metric key or sensor key to display on the bar")
    p_bar.set_defaults(func=cmd_bar_metric)
    
    args = parser.parse_args()
    args.func(args)

if __name__ == "__main__":
    main()
